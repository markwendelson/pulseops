# ==========================================
# Root .gitignore for PulseOps Monorepo
# ==========================================

# OS Metadata
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini

# IDE & Editors
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.user
*.sw?

# ------------------------------------------
# Frontend (Node / Vite / React)
# ------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local
!frontend/.env.example
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Backend (.NET 8 Web API / EF Core)
# ------------------------------------------
backend/[Bb]in/
backend/[Oo]bj/
backend/.vs/
backend/TestResults/
backend/appsettings.Development.json
backend/appsettings.Production.json
backend/appsettings.Local.json
backend/*.local.json
backend/*.db
backend/*.sqlite
backend/*.sqlite3

# General Build Artifacts & Logs
[Bb]in/
[Oo]bj/
[Ll]ogs/
*.log
