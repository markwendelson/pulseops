# PulseOps Frontend Environment Configuration

# Set to 'true' to use local mock JSON datasets (Phases 1-4)
# Set to 'false' to connect to live .NET 8 Web API & TimescaleDB (Phase 5+)
VITE_USE_MOCKS=true

# Target Backend API URL (.NET 8 Web API)
VITE_API_BASE_URL=http://localhost:5000/api

# Refresh interval for polling telemetry in milliseconds (default: 10 seconds)
VITE_TELEMETRY_REFRESH_INTERVAL=10000

# Application Details
VITE_APP_TITLE=PulseOps
VITE_APP_ENV=development
